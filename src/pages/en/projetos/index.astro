---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';
import { getReposData } from '../../../utils/github';

const lang = 'en';
const t = useTranslations(lang);

const projects = (await getCollection('projetos', ({ id }) => {
  return id.startsWith('en/');
})).sort((a, b) => b.data.year - a.data.year);

const repoNames = projects.map(p => p.data.repo).filter((r): r is string => !!r);
const githubStats = await getReposData(repoNames);
---

<BaseLayout 
  title={t('nav.projetos')} 
  description="Portfolio of projects developed by Ronca, including DevOps, DevSecOps, and security tools." 
  lang={lang}
>
  <div class="projects-container">
    <header class="page-header">
      <h1 class="page-title">{t('nav.projetos')}</h1>
      <p class="page-subtitle">
        Open-source projects, CLI tools, and experiments in systems and infrastructure.
      </p>
    </header>

    <div class="projects-grid">
      {projects.map((project, index) => (
        <ProjectCard 
          project={project} 
          index={index} 
          gitHubData={project.data.repo ? githubStats[project.data.repo] : undefined} 
          lang={lang} 
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-container {
    width: 100%;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    color: var(--color-dim);
    font-size: var(--text-lg);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
