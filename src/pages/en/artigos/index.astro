---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

const articles = (await getCollection('artigos', ({ id, data }) => {
  return id.startsWith('en/') && !data.draft;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title={t('nav.artigos')} 
  description="Technical notes, implementation guides, and articles about systems security, Kubernetes, DevOps, and architecture." 
  lang={lang}
>
  <div class="articles-container">
    <header class="page-header">
      <h1 class="page-title">{t('nav.artigos')}</h1>
      <p class="page-subtitle">
        Technical notes, implementation guides, and reflections on architecture and resilient systems.
      </p>
    </header>

    <div class="articles-grid">
      {articles.map(article => (
        <ArticleCard article={article} lang={lang} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .articles-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    color: var(--color-dim);
    font-size: var(--text-lg);
    margin: 0;
  }

  .articles-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
