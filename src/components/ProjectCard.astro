---
import { type Locale, useTranslations } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';
import { Star, Code, Clock, Github, ExternalLink, BookOpen } from '@lucide/astro';

interface Props {
  project: CollectionEntry<'projetos'>;
  index: number;
  gitHubData?: {
    stars: number;
    language: string | null;
    lastCommit: string;
  };
  lang: Locale;
}

const { project, index, gitHubData, lang } = Astro.props;
const t = useTranslations(lang);

const formatCommitDate = (dateStr: string) => {
  try {
    const date = new Date(dateStr);
    return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-US', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }).format(date);
  } catch {
    return dateStr;
  }
};

const brackets = [
  ['{', '}'],
  ['[', ']'],
  ['<', '>'],
];
const [openBracket, closeBracket] = brackets[index % brackets.length];

const status = project.data.status || 'ativo';
const statusText = t(`project.status.${status}`);

const stars = gitHubData?.stars ?? 0;
const language = gitHubData?.language ?? project.data.stack[0] ?? '';
const lastCommit = gitHubData?.lastCommit 
  ? formatCommitDate(gitHubData.lastCommit) 
  : project.data.year.toString();
---

<div class="project-card">
  <span class="bracket-decor top-left">{openBracket}</span>
  <span class="bracket-decor bottom-right">{closeBracket}</span>

  <div class="card-header">
    <div class="project-title-group">
      <span class="title-comment">//</span>
      <h3 class="project-title">{project.data.title}</h3>
    </div>
    
    <div class="project-status">
      <span class="status-label">{statusText}</span>
      <span class={`status-dot ${status}`} title={statusText}></span>
    </div>
  </div>

  <div class="card-body">
    <p class="project-description">
      {project.data.description}
    </p>

    <div class="project-stack">
      {project.data.stack.map(tech => (
        <span class="tech-tag">
          <span class="tag-bracket">[</span>{tech}<span class="tag-bracket">]</span>
        </span>
      ))}
    </div>
  </div>

  <div class="card-footer">
    <div class="github-stats">
      {project.data.repo && (
        <>
          <div class="stat-item" title={t('project.stars')}>
            <Star size={14} />
            <span>{stars}</span>
          </div>

          <div class="stat-item" title={t('project.language')}>
            <Code size={14} />
            <span>{language}</span>
          </div>

          <div class="stat-item" title={t('project.lastCommit')}>
            <Clock size={14} />
            <span>{lastCommit}</span>
          </div>
        </>
      )}
    </div>

    <div class="project-links">
      {project.data.links?.repo && (
        <a href={project.data.links.repo} target="_blank" rel="noopener noreferrer" class="link-btn" title="Repository">
          <Github size={16} />
        </a>
      )}
      {project.data.links?.demo && (
        <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer" class="link-btn" title="Live Demo">
          <ExternalLink size={16} />
        </a>
      )}
      {project.data.links?.writeup && (
        <a href={project.data.links.writeup} class="link-btn" title="Writeup">
          <BookOpen size={16} />
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .project-card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(94, 242, 184, 0.05);
  }

  .bracket-decor {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    color: rgba(94, 242, 184, 0.1);
    pointer-events: none;
    font-weight: 300;
    line-height: 1;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .top-left {
    top: var(--space-2);
    left: var(--space-3);
  }

  .bottom-right {
    bottom: var(--space-2);
    right: var(--space-3);
  }

  .project-card:hover .bracket-decor {
    color: var(--color-accent);
  }

  .project-card:hover .top-left {
    transform: translate(-2px, -2px);
  }

  .project-card:hover .bottom-right {
    transform: translate(2px, 2px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
  }

  .project-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .title-comment {
    font-family: var(--font-mono);
    color: var(--color-dim);
    font-weight: 700;
  }

  .project-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .project-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-dim);
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    position: relative;
  }

  .status-dot.ativo {
    background-color: var(--color-accent);
  }

  .status-dot.wip {
    background-color: #f59e0b;
  }

  .status-dot.arquivado {
    background-color: var(--color-dim);
  }

  .status-dot.ativo::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--color-accent);
    animation: pulse 1.8s infinite ease-in-out;
    opacity: 0;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .project-description {
    color: var(--color-dim);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0 0 var(--space-4) 0;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
  }

  .tag-bracket {
    color: var(--color-border);
    transition: color 0.2s ease;
  }

  .project-card:hover .tag-bracket {
    color: var(--color-accent);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-4);
    margin-top: var(--space-2);
  }

  .github-stats {
    display: flex;
    gap: var(--space-4);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-dim);
  }

  .stat-item svg {
    opacity: 0.7;
  }

  .project-links {
    display: flex;
    gap: var(--space-2);
  }

  .link-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    color: var(--color-dim);
    transition: all 0.2s ease;
    background-color: transparent;
  }

  .link-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: rgba(94, 242, 184, 0.05);
    transform: scale(1.05);
  }
</style>
